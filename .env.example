# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# One LLM key is enough. With both, Claude is tried first and Gemini is the fallback.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional
# BEAT_AGENT_LLM=auto                   # auto | anthropic | gemini
# BEAT_AGENT_MODEL=claude-opus-5-5      # any Claude model with tool use; claude-sonnet-5-5 halves the cost
# BEAT_AGENT_EFFORT=medium              # low | medium | high
# BEAT_AGENT_GEMINI_MODEL=              # first Gemini model to try; default: newest stable Flash, then Flash-Lite, then Pro
# BEAT_AGENT_PACK=testpack/stand-in     # point at the real test pack when you have it
# BEAT_AGENT_DEVICE=cpu                 # cuda works but is not required
# BEAT_AGENT_INTERPRETER=auto           # auto (LLM if the key works, else offline grammar) | llm | offline
