# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets
.env

# Private material that must not go into a public repo
_brief/
_private/

# Local tooling
.claude/

# Runtime state of the web app (uploads, per-session renders)
runtime/

# Model caches
.cache/

# The stand-in audio is regenerated by `python -m testpack.generate` (deterministic, ~230 MB).
# Its reference annotations, MIDI and manifest are small and are committed.
testpack/stand-in/*.wav
testpack/stand-in/*.flac
testpack/stand-in/*.mp3

# Full-resolution eval audio is regenerated by `make evals` and packaged for a release by
# `make package`; the repo carries MP3 listening copies (~90 kbps), all JSON reports, grids,
# EDLs, transcripts, scores, pages and the Part 3 renders.
evals/out/part1/**/*.wav
evals/out/part2/**/*.wav
evals/out/part2/**/*.flac
# The offline-grammar and live-LLM runs' audio (WAV/FLAC) is byte-identical to the reference run's
# (sha256), so the repo keeps one set of MP3 listening copies: reference/.
evals/out/part2/offline/**/*.mp3
evals/out/part2/s[0-9]_*/**/*.mp3

# Release zips (scripts/package_artifacts.py)
dist/
# A replay re-runs the live run's recorded tool calls; its outputs duplicate the live run's.
evals/out/part2/replay/
